#[unsafe(no_mangle)]
pub extern "C" fn rust_gpio2_low() {
    system_init();

    let mut peripherals = Peripherals::take().expect("peripherals already taken");
    let mut gpio2 = peripherals.gpio.output::<2>();
    gpio2.set_low();
}

